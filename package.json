{
  "name": "razorpay-ai-revenue-recovery",
  "version": "1.0.0",
  "description": "AI-powered payment failure recovery agent for Razorpay Buildathon",
  "scripts": {
    "build": "tsc",
    "dev:ingestion": "ts-node ingestion/server.ts",
    "test": "jest --runInBand",
    "test:policy": "jest tests/policyEngine.test.ts --runInBand",
    "test:integration": "jest tests/integration.test.ts --runInBand",
    "run:batch": "ts-node synthetic-data/runBatch.ts",
    "generate:payload": "ts-node generateTestWebhookPayload.ts",
    "reconcile": "ts-node executor/reconcileStuckPending.ts"
  },
  "dependencies": {
    "razorpay": "^2.9.2",
    "express": "^4.18.2",
    "better-sqlite3": "^9.4.3",
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "twilio": "^5.0.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.4.3",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    }
  }
}
