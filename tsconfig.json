{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "shared/**/*",
    "ingestion/**/*",
    "policy/**/*",
    "executor/**/*",
    "audit/**/*",
    "synthetic-data/**/*",
    "tests/**/*",
    "razorpayClient.ts",
    "smsClient.ts",
    "generateTestWebhookPayload.ts"
  ],
  "exclude": ["node_modules", "dist", "diagnosis"]
}
