# ── Razorpay credentials (get from dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Twilio credentials (get from console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=



# ── Google AI (Gemini) for the diagnosis LLM

GOOGLE_API_KEY=

# ── Diagnosis service URL (Python FastAPI)
DIAGNOSIS_SERVICE_URL=http://localhost:8000

# ── SQLite database file path
DATABASE_PATH=./audit/recovery.db

# ── Ingestion server port
PORT=3000

# ── Pipeline mode: "test" or "live" — reject events that don't match
PIPELINE_MODE=test

# ── Reconciliation: how many minutes before a PENDING record is considered stuck
RECONCILE_TIMEOUT_MINUTES=10

